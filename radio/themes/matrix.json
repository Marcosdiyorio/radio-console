{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "faint": "$hue.neutral.500",
      "feedback": {
        "error": { "base": "$hue.red.300" },
        "success": { "base": "$hue.green.200" },
        "warning": { "base": "$hue.yellow.200" }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": { "base": "$hue.neutral.800", "high": "$hue.neutral.700", "max": "$hue.neutral.600" }
    },
    "border": { "base": "$hue.neutral.600" },
    "categorical": ["accent", "green", "blue", "purple"]
  },
  "dark": {
    "hue": {
      "gray": { "100": "#f0f6fc", "200": "#c9d1d9", "300": "#8b949e", "400": "#6e7681", "500": "#484f58", "600": "#30363d", "700": "#21262d", "800": "#161b22", "900": "#0d1117" },
      "green": { "100": "#7ee787", "200": "#56d364", "300": "#3fb950", "400": "#2ea043", "500": "#238636", "600": "#1a7f37", "700": "#116329", "800": "#0d4429", "900": "#033a16" },
      "red": { "100": "#ffa198", "200": "#ff7b72", "300": "#f85149", "400": "#da3633", "500": "#b62324", "600": "#8e1519", "700": "#67060c", "800": "#490206", "900": "#2d0004" },
      "yellow": { "100": "#f8e3a1", "200": "#e3b341", "300": "#bb8009", "400": "#9e6a03", "500": "#8a6d3b", "600": "#6d5a1e", "700": "#5a4a1a", "800": "#3d3312", "900": "#261f08" },
      "blue": { "100": "#a5d6ff", "200": "#79c0ff", "300": "#58a6ff", "400": "#388bfd", "500": "#1f6feb", "600": "#1158c7", "700": "#0d419d", "800": "#0a3069", "900": "#051d4d" },
      "purple": { "100": "#d2a8ff", "200": "#bc8cff", "300": "#a371f7", "400": "#8957e5", "500": "#6e40c9", "600": "#553098", "700": "#3c1e70", "800": "#271052", "900": "#1b0a3c" },
      "accent": "$hue.green",
      "interactive": "$hue.green",
      "neutral": "$hue.gray"
    }
  },
  "light": {
    "hue": {
      "gray": { "100": "#0d1117", "200": "#1f2328", "300": "#32383f", "400": "#424a53", "500": "#57606a", "600": "#6e7781", "700": "#8c959f", "800": "#afb8c1", "900": "#d0d7de" },
      "green": { "100": "#033a16", "200": "#0d4429", "300": "#116329", "400": "#1a7f37", "500": "#238636", "600": "#2ea043", "700": "#3fb950", "800": "#56d364", "900": "#7ee787" },
      "red": { "100": "#2d0004", "200": "#490206", "300": "#67060c", "400": "#8e1519", "500": "#b62324", "600": "#da3633", "700": "#f85149", "800": "#ff7b72", "900": "#ffa198" },
      "yellow": { "100": "#261f08", "200": "#3d3312", "300": "#5a4a1a", "400": "#6d5a1e", "500": "#8a6d3b", "600": "#9e6a03", "700": "#bb8009", "800": "#e3b341", "900": "#f8e3a1" },
      "blue": { "100": "#051d4d", "200": "#0a3069", "300": "#0d419d", "400": "#1158c7", "500": "#1f6feb", "600": "#388bfd", "700": "#58a6ff", "800": "#79c0ff", "900": "#a5d6ff" },
      "purple": { "100": "#1b0a3c", "200": "#271052", "300": "#3c1e70", "400": "#553098", "500": "#6e40c9", "600": "#8957e5", "700": "#a371f7", "800": "#bc8cff", "900": "#d2a8ff" },
      "accent": "$hue.green",
      "interactive": "$hue.green",
      "neutral": "$hue.gray"
    }
  }
}
