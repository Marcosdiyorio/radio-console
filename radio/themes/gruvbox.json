{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "faint": "$hue.neutral.500",
      "feedback": {
        "error": {
          "base": "$hue.red.300"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "warning": {
          "base": "$hue.yellow.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      }
    },
    "border": {
      "base": "$hue.neutral.600"
    },
    "categorical": [
      "accent",
      "green",
      "blue",
      "purple"
    ]
  },
